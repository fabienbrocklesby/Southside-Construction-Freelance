{
  "kind": "collectionType",
  "collectionName": "gallery_photos",
  "info": {
    "singularName": "gallery-photo",
    "pluralName": "gallery-photos",
    "displayName": "Gallery Photo",
    "description": "Editable gallery photos with captions, alt text, category, and order."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "caption": {
      "type": "string"
    },
    "altText": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gallery-category.gallery-category",
      "inversedBy": "photos"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    }
  }
}
