{
  "kind": "collectionType",
  "collectionName": "gallery_categories",
  "info": {
    "singularName": "gallery-category",
    "pluralName": "gallery-categories",
    "displayName": "Gallery Category",
    "description": "Editable gallery categories for organizing project photos."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "thumbnailImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "thumbnailAltText": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "photos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-photo.gallery-photo",
      "mappedBy": "category"
    }
  }
}
