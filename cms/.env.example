# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# Local development database.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production SQLite in Docker should use the persistent volume path below.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=/srv/app/data/data.db

# Optional production database example for PostgreSQL.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Local and production media uploads: Cloudflare R2 via Strapi's official S3 provider.
# If R2 is enabled or R2 credentials are present, Strapi will fail startup instead of silently using local uploads.
R2_UPLOAD_ENABLED=true
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Backwards-compatible alias also supported:
# R2_ACCESS_SECRET=
R2_BUCKET=southside-construction-strapi-media
R2_ENDPOINT=https://9f08cc5b560a2570e12982550b39f6ac.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-8fffd787049d49baa5ea1904061fcd51.r2.dev
# R2_ROOT_PATH=
# UPLOAD_SIZE_LIMIT_BYTES=26214400

# Optional: used by scripts/seed-current-content.mjs
# STRAPI_URL=http://localhost:1337
# STRAPI_API_TOKEN=

# Optional: POSTed by Strapi after content/media changes so Cloudflare Pages rebuilds static HTML.
# Keep this URL secret.
# CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=
# PAGES_REBUILD_DEBOUNCE_MS=10000
