# Copy to cms/.env.production on the VPS. Do not commit real values.
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Keep SQLite on the Docker volume mounted at /srv/app/data.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=/srv/app/data/data.db

# Cloudflare R2 media storage. Create this bucket for this repo.
R2_UPLOAD_ENABLED=true
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Backwards-compatible alias also supported:
# R2_ACCESS_SECRET=
R2_BUCKET=southside-construction-strapi-media
R2_ENDPOINT=https://9f08cc5b560a2570e12982550b39f6ac.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-8fffd787049d49baa5ea1904061fcd51.r2.dev
R2_ROOT_PATH=
UPLOAD_SIZE_LIMIT_BYTES=26214400

# Cloudflare Pages deploy hook. Create it under Workers & Pages > project > Settings > Builds.
# Keep this URL secret; anyone with it can trigger frontend rebuilds.
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=
PAGES_REBUILD_DEBOUNCE_MS=10000
