---
import type { ServiceCard } from "../lib/cms";
import { cfImage, cfSrcSet } from "../utils/images";

type Props = {
  card: ServiceCard;
  index?: number;
};

const { card, index = 0 } = Astro.props;
---

<article
  class="group rounded-xl border overflow-hidden bg-white"
  data-aos="zoom-in"
  data-aos-delay={index ? String(index * 100) : undefined}
>
  <figure class="aspect-[4/3] overflow-hidden">
    <img
      src={cfImage(card.image.src, { width: 640, quality: 75 })}
      srcset={cfSrcSet(card.image.src, [320, 480, 640], { quality: 75 })}
      sizes="(min-width: 1280px) 25vw, (min-width: 768px) 50vw, 100vw"
      alt={card.image.alt}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      width={card.image.width ?? 640}
      height={card.image.height ?? 480}
    />
  </figure>
  <div class="p-5 space-y-2">
    <h3 class="text-xl font-semibold">{card.title}</h3>
    <p class="text-sm opacity-80">{card.description}</p>
    {
      card.bulletPoints.length > 0 && (
        <ul class="text-sm list-disc pl-5 space-y-1 opacity-90">
          {card.bulletPoints.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
