---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGalleryContent } from "../lib/cms";
import { cfImage, cfSrcSet } from "../utils/images";

const { categories, photos } = await getGalleryContent();
const photoCounts = new Map<string, number>();

for (const photo of photos) {
  if (!photo.categorySlug) continue;
  photoCounts.set(photo.categorySlug, (photoCounts.get(photo.categorySlug) ?? 0) + 1);
}
---

<BaseLayout title="Gallery">
  <!-- Header -->
  <header class="mb-6" data-aos="fade-down">
    <h1 class="text-4xl font-bold">Project Gallery</h1>
    <p class="opacity-80 mt-2">
      A curated look at our builds across Nelson & Tasman. Choose a category to
      view the project photos.
    </p>
  </header>

  <!-- Category Gallery -->
  <section
    aria-label="Gallery categories"
    class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    data-aos="fade-up"
  >
    {
      categories.map((category) => {
        const photoCount = photoCounts.get(category.slug) ?? 0;

        return (
          <a
            href={`/gallery/${category.slug}`}
            class="group block overflow-hidden rounded-xl border bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            <div class="relative overflow-hidden rounded-xl">
              <img
                src={cfImage(category.thumbnail.src, { width: 960, quality: 78 })}
                srcset={cfSrcSet(category.thumbnail.src, [480, 720, 960], {
                  quality: 78,
                })}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                alt={category.thumbnail.alt}
                loading="lazy"
                decoding="async"
                class="h-64 w-full rounded-xl object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                <h2 class="text-2xl font-bold">{category.title}</h2>
                {photoCount > 0 && (
                  <p class="mt-1 text-sm opacity-90">
                    {photoCount} {photoCount === 1 ? "photo" : "photos"}
                  </p>
                )}
              </div>
            </div>
          </a>
        );
      })
    }
  </section>

  <!-- CTA -->
  <section
    class="mt-10 relative overflow-hidden rounded-xl"
    aria-label="Call to action"
    data-aos="fade-in"
  >
    <img
      src="/thumbs/960/IMG_0611.jpg"
      srcset="/thumbs/640/IMG_0611.jpg 640w, /thumbs/960/IMG_0611.jpg 960w"
      sizes="100vw"
      alt="Outdoor living space"
      class="w-full h-56 md:h-72 object-cover"
      loading="lazy"
      width="960"
      height="720"
    />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-5xl mx-auto px-4 text-white">
        <h2 class="text-2xl md:text-3xl font-bold">Love what you see?</h2>
        <p class="mt-2 opacity-90">
          Tell us about your project and we'll outline practical next steps.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary text-white"
            >Request a quote</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
