---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fallbackAboutContent, getAboutContent } from "../lib/cms";
import { cfImage, cfSrcSet } from "../utils/images";

const aboutContent = await getAboutContent();
const firstSideImage = aboutContent.sideImages[0] ?? fallbackAboutContent.sideImages[0];
const secondSideImage = aboutContent.sideImages[1] ?? fallbackAboutContent.sideImages[1];
const featureSideImage = aboutContent.sideImages[2] ?? fallbackAboutContent.sideImages[2];
---

<BaseLayout title="About">
  <!-- Hero -->
  <section
    class="relative overflow-hidden rounded-xl"
    aria-label="About Southside Construction"
    data-aos="fade-in"
  >
    <img
      src={cfImage("/images/IMG_1203.jpg", { width: 1600, quality: 78 })}
      srcset={cfSrcSet("/images/IMG_1203.jpg", [640, 960, 1280, 1600, 2000], {
        quality: 78,
      })}
      sizes="100vw"
      alt="Southside Construction project in Nelson Tasman"
      class="w-full h-[45vh] min-h-[320px] object-cover hero-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/20"
    >
    </div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-5xl mx-auto px-4 pb-8 text-white">
        <h1 class="text-4xl md:text-5xl font-bold">
          About Southside Construction
        </h1>
        <p class="mt-3 max-w-3xl text-base md:text-lg opacity-95">
          Local builders delivering new homes, renovations, sheds, decks and
          fencing across Nelson & Tasman. We combine tidy workmanship with
          straight-up communication and reliable timelines.
        </p>
      </div>
    </div>
  </section>

  <!-- Our story -->
  <section class="py-12" aria-labelledby="our-story">
    <div class="grid gap-8 md:grid-cols-2 items-start">
      <div data-aos="fade-right">
        <h2 id="our-story" class="text-3xl md:text-4xl font-bold">Our story</h2>
        <p class="mt-4 opacity-90">
          We started Southside Construction to build well-crafted homes and
          practical structures that suit our region. That means designing for
          Tasman’s weather, using durable materials, and paying attention to the
          details you’ll live with every day.
        </p>
        <p class="mt-3 opacity-90">
          From the first site visit to handover, you’ll get clear timelines,
          tidy sites, and honest updates. We value relationships with clients,
          designers, and local suppliers — because great outcomes come from a
          team that works well together.
        </p>
        <div class="mt-6 flex gap-3 flex-wrap">
          <a href="/contact" class="btn btn-primary text-white">Book a chat</a>
          <a href="/gallery" class="btn btn-outline">See our work</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4" data-aos="fade-left">
        <img
          src="/thumbs/640/IMG_0323.jpg"
          srcset="/thumbs/320/IMG_0323.jpg 320w, /thumbs/480/IMG_0323.jpg 480w, /thumbs/640/IMG_0323.jpg 640w"
          sizes="(min-width: 768px) 12rem, 11rem"
          alt="Framing detail on site"
          class="rounded-xl w-full h-44 md:h-56 object-cover"
          loading="lazy"
          width="640"
          height="480"
        />
        <img
          src="/thumbs/640/IMG_0611.jpg"
          srcset="/thumbs/320/IMG_0611.jpg 320w, /thumbs/480/IMG_0611.jpg 480w, /thumbs/640/IMG_0611.jpg 640w"
          sizes="(min-width: 768px) 12rem, 11rem"
          alt="Outdoor living space built by Southside"
          class="rounded-xl w-full h-44 md:h-56 object-cover"
          loading="lazy"
          width="640"
          height="480"
        />
        <img
          src="/thumbs/960/IMG_1104.jpg"
          srcset="/thumbs/640/IMG_1104.jpg 640w, /thumbs/960/IMG_1104.jpg 960w"
          sizes="(min-width: 768px) 24rem, 22rem"
          alt="Finished exterior elevation"
          class="rounded-xl w-full h-44 md:h-56 object-cover col-span-2"
          loading="lazy"
          width="960"
          height="720"
        />
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-12" aria-labelledby="values">
    <h2
      id="values"
      class="text-3xl md:text-4xl font-bold mb-6"
      data-aos="fade-up"
    >
      What we stand for
    </h2>
    <div
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-4"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Craftsmanship</h3>
        <p class="text-sm opacity-80 mt-1">
          Tidy work, accurate lines, and durable assemblies designed for local
          conditions.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Communication</h3>
        <p class="text-sm opacity-80 mt-1">
          Clear scopes, regular updates, and no surprises on timelines or cost
          drivers.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Safety</h3>
        <p class="text-sm opacity-80 mt-1">
          Qualified team, safe sites, and tidy operations that respect your
          home.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Sustainability</h3>
        <p class="text-sm opacity-80 mt-1">
          Smart material choices and energy-efficient builds that perform over
          time.
        </p>
      </div>
    </div>
  </section>

  <!-- Credentials / Trust -->
  <section class="py-12" aria-labelledby="credentials">
    <h2
      id="credentials"
      class="text-3xl md:text-4xl font-bold mb-6"
      data-aos="fade-up"
    >
      Licensed. Local. Reliable.
    </h2>
    <div
      class="grid gap-6 md:grid-cols-3"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <div class="rounded-xl border p-5 bg-white">
        <div class="text-2xl font-bold">Licensed</div>
        <p class="text-sm opacity-80 mt-1">
          Qualified, licensed building practitioners.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <div class="text-2xl font-bold">Insured</div>
        <p class="text-sm opacity-80 mt-1">
          Appropriate insurances and health & safety policies for peace of mind.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <div class="text-2xl font-bold">Local suppliers</div>
        <p class="text-sm opacity-80 mt-1">
          We source materials locally where possible for quality and support.
        </p>
      </div>
    </div>
  </section>

  <!-- Areas and capabilities -->
  <section class="py-12" aria-labelledby="areas">
    <div class="grid gap-8 md:grid-cols-2 items-center">
      <div data-aos="fade-right">
        <h2 id="areas" class="text-3xl md:text-4xl font-bold">
          {aboutContent.whereWeBuildTitle}
        </h2>
        <p class="mt-4 opacity-90">
          {aboutContent.whereWeBuildMainText}
        </p>
        <ul class="mt-4 grid grid-cols-2 gap-2 text-sm opacity-90">
          {aboutContent.capabilityItems.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-3 text-sm opacity-80">
          Got something else in mind? We also take on custom projects after a
          quick conversation to scope it properly.
        </p>
        <div class="mt-5 flex gap-3 flex-wrap">
          <a href="/contact" class="btn btn-primary text-white"
            >Ask about your project</a
          >
          <a href="/gallery" class="btn btn-outline">Project gallery</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4" data-aos="fade-left">
        <img
          src={cfImage(firstSideImage.src, { width: 640, quality: 75 })}
          srcset={cfSrcSet(firstSideImage.src, [320, 480, 640], {
            quality: 75,
          })}
          sizes="(min-width: 768px) 15rem, 12rem"
          alt={firstSideImage.alt}
          class="rounded-xl h-48 md:h-60 w-full object-cover"
          loading="lazy"
          width={firstSideImage.width ?? 640}
          height={firstSideImage.height ?? 480}
        />
        <img
          src={cfImage(secondSideImage.src, { width: 640, quality: 75 })}
          srcset={cfSrcSet(secondSideImage.src, [320, 480, 640], {
            quality: 75,
          })}
          sizes="(min-width: 768px) 15rem, 12rem"
          alt={secondSideImage.alt}
          class="rounded-xl h-48 md:h-60 w-full object-cover"
          loading="lazy"
          width={secondSideImage.width ?? 640}
          height={secondSideImage.height ?? 480}
        />
        <img
          src={cfImage(featureSideImage.src, { width: 960, quality: 75 })}
          srcset={cfSrcSet(featureSideImage.src, [640, 960], {
            quality: 75,
          })}
          sizes="(min-width: 768px) 30rem, 24rem"
          alt={featureSideImage.alt}
          class="rounded-xl h-48 md:h-60 w-full object-cover col-span-2"
          loading="lazy"
          width={featureSideImage.width ?? 960}
          height={featureSideImage.height ?? 720}
        />
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="py-12" aria-labelledby="approach">
    <h2
      id="approach"
      class="text-3xl md:text-4xl font-bold mb-6"
      data-aos="fade-up"
    >
      Our approach
    </h2>
    <div
      class="grid gap-6 md:grid-cols-3"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Plan with purpose</h3>
        <p class="text-sm opacity-80 mt-1">
          We listen first, then shape a scope and timeline that fits your budget
          and goals.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Build with care</h3>
        <p class="text-sm opacity-80 mt-1">
          Clean sites, qualified builders, and attention to the little things
          that last.
        </p>
      </div>
      <div class="rounded-xl border p-5 bg-white">
        <h3 class="font-semibold">Stand behind it</h3>
        <p class="text-sm opacity-80 mt-1">
          We hand over thoroughly and stay available — no loose ends.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section
    class="relative overflow-hidden rounded-xl"
    aria-label="Contact Southside"
    data-aos="fade-in"
  >
    <img
      data-src={cfImage("/images/IMG_0611.jpg", { width: 1600, quality: 78 })}
      data-srcset={cfSrcSet("/images/IMG_0611.jpg", [640, 960, 1280, 1600], {
        quality: 78,
      })}
      sizes="100vw"
      alt="Outdoor deck and entertaining area"
      class="w-full h-56 md:h-72 object-cover"
    />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-5xl mx-auto px-4 text-white">
        <h2 class="text-2xl md:text-3xl font-bold">
          Let’s talk about your build
        </h2>
        <p class="mt-2 opacity-90">
          Tell us what you’re planning — we’ll outline practical next steps and
          a realistic timeline.
        </p>
        <div class="mt-4 flex gap-3 flex-wrap">
          <a href="/contact" class="btn btn-primary text-white"
            >Request a quote</a
          >
          <a href="/contact" class="btn btn-outline">Book a site visit</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
