---
import type { GetStaticPaths } from "astro";
import GalleryMasonry from "../../components/GalleryMasonry.astro";
import { getGalleryContent, type GalleryCategory, type GalleryPhoto } from "../../lib/cms";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Props = {
  category: GalleryCategory;
  photos: GalleryPhoto[];
};

export const getStaticPaths = (async () => {
  const { categories, photos } = await getGalleryContent();

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      photos: photos.filter((photo) => photo.categorySlug === category.slug),
    },
  }));
}) satisfies GetStaticPaths;

const { category, photos } = Astro.props;
const pageTitle = category.title.toLowerCase().includes("gallery")
  ? category.title
  : `${category.title} Gallery`;
---

<BaseLayout title={pageTitle}>
  <header class="mb-6" data-aos="fade-down">
    <a href="/gallery" class="btn btn-sm btn-outline mb-5">Back to gallery</a>
    <h1 class="text-4xl font-bold">{category.title}</h1>
    <p class="opacity-80 mt-2">
      Click any photo to view larger.
    </p>
  </header>

  {
    photos.length ? (
      <GalleryMasonry photos={photos} label={`${category.title} photos`} />
    ) : (
      <section class="rounded-xl border bg-white p-6" data-aos="fade-up">
        <h2 class="text-2xl font-bold">No photos published yet</h2>
        <p class="mt-2 opacity-80">
          This category is ready, but there are no published photos assigned to it.
        </p>
        <a href="/gallery" class="btn btn-primary mt-5 text-white">View categories</a>
      </section>
    )
  }
</BaseLayout>
